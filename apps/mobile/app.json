{
  "expo": {
    "name": "KashFlow",
    "slug": "kashflow",
    "scheme": "kashflow",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "ke.kashflow.inventory",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "KashFlow uses the camera to scan product barcodes when you choose camera scanning in Point of Sale."
      }
    },
    "android": {
      "package": "ke.kashflow.inventory",
      "permissions": ["android.permission.CAMERA"],
      "adaptiveIcon": {
      "backgroundColor": "#123139",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      ["expo-sqlite", { "useSQLCipher": true }],
      "expo-secure-store"
    ]
  }
}
