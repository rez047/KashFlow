NODE_ENV=development
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kashflow
# Production only: use `require` for Render's self-signed internal Postgres TLS,
# or `verify-full` when the database certificate chains to a trusted CA (default).
# DATABASE_SSL_MODE=require
SESSION_SECRET=replace-with-at-least-32-random-characters-before-production
PAYROLL_DATA_ENCRYPTION_KEY=generate-a-separate-random-secret-at-least-32-characters
# Optional platform backup operator. Configure all S3 fields and install PostgreSQL pg_dump/pg_restore.
# Hourly logical database dumps are written to private S3-compatible object storage with SSE-S3 AES256.
# Keep BACKUP_OPERATOR_TOKEN server-side; it authorizes full-database restore across every business.
# BACKUP_OPERATOR_TOKEN=generate-a-separate-random-secret-at-least-32-characters
# Restore only: stop all API instances and workers, then start exactly one API in maintenance mode.
# That instance rejects normal API traffic and skips migrations until it is restarted normally.
# BACKUP_RESTORE_MAINTENANCE_MODE=false
# BACKUP_S3_ENDPOINT=https://s3.example.com
# BACKUP_S3_REGION=us-east-1
# BACKUP_S3_BUCKET=kashflow-private-backups
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# Optional Daraja STK Push. Fill all five required MPESA_* values after merchant onboarding.
# Keep secrets server-side; never add them to VITE_* variables.
MPESA_ENV=sandbox
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_CALLBACK_URL=https://your-api-domain.example/v1/integrations/mpesa/callback
# MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Optional outbound email through Resend (legacy). Brevo is preferred for email and SMS.
# RESEND_API_KEY=re_...
# EMAIL_FROM=billing@your-verified-domain.example
# Optional live bank-data consent/feed using Mono (Kenya coverage listed by Mono).
# Complete Mono Partner Dashboard business/KYB approval and confirm bank availability first.
# MONO_PUBLIC_KEY=live_pk_...
# MONO_SECRET_KEY=live_sk_...
# MONO_WEBHOOK_SECRET=your-webhook-secret
# MONO_SYNC_INTERVAL_MINUTES=60
# KRA eTIMS OSCU adapter. Sandbox is default. Production requires KRA approval/certification
# plus a deliberate operator change of KRA_ETIMS_ENV and KRA_ETIMS_LIVE_ENABLED.
KRA_ETIMS_ENV=sandbox
KRA_ETIMS_LIVE_ENABLED=false
# Generate a distinct stable random 32+ character key; never expose it to Vite.
# KRA_ETIMS_CREDENTIALS_ENCRYPTION_KEY=
# Optional WooCommerce REST API secret encryption. Use a separate stable random
# key of at least 32 characters; losing/changing it prevents credential decryption.
# ONLINE_COMMERCE_ENCRYPTION_KEY=
# Two-factor authentication (authenticator app). Generate a distinct stable random 32+ character
# key. Without it, two-factor setup returns 503 and stays unavailable. No paid dependency is used.
# TWO_FACTOR_ENCRYPTION_KEY=
# Brevo transactional messaging (works on the Brevo free tier).
# - BREVO_API_KEY unlocks email and SMS sending.
# - BREVO_SENDER_EMAIL / BREVO_SENDER_NAME must be a Brevo-verified sender for email.
# - BREVO_SMS_SENDER is the SMS sender label (maximum 11 characters, alphanumeric).
# - BREVO_WHATSAPP_NUMBER only works after Brevo approves a WhatsApp sender (not free tier).
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
# BREVO_SENDER_NAME=KashFlow
# BREVO_SMS_SENDER=KashFlow
# BREVO_WHATSAPP_NUMBER=
# Set this in the frontend root .env.local, not in this API file.
# VITE_API_BASE_URL=http://localhost:3001
