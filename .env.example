# Public API URL consumed by the Vite browser bundle. This is not a secret.
VITE_API_BASE_URL=http://localhost:3001

# Optional public store listing links shown on the landing page after mobile release.
# Use HTTPS TestFlight/App Store and Google Play URLs. These are not secrets.
#
# iOS: Apple does not allow installing an .ipa from a web page, so this must be a
# TestFlight or App Store listing URL. Leave it empty until the app is listed; iOS
# then shows "App Store release pending" instead of a broken link.
# Android: leave empty to serve the APK attached to the stable v* release directly.
# Set it only when you want the button to open a Google Play listing instead.
VITE_IOS_DISTRIBUTION_URL=
VITE_ANDROID_DISTRIBUTION_URL=
